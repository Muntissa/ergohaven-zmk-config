/*
 * Ergohaven K:03  —  ergonomic keymap
 *
 * Layers:
 *   0 BASE  default (Windows mode)
 *   1 MAC   OS overlay, toggled from ADJ (&tog MAC). Swaps Ctrl<->Cmd on the
 *           home row so copy/paste/save/build are the SAME finger on Win & Mac.
 *   2 NAV   hold left thumb   — arrows, F-keys, navigation
 *   3 SYM   hold right thumb  — programming symbols
 *   4 ADJ   NAV + SYM together — BT, output, media, OS toggle, screen, system
 *
 * Home-row mods (ergohaven op36 order: index=Ctrl, middle=Shift, ring=Alt, pinky=Gui)
 *   Win:  A=Gui  S=Alt  D=Shift  F=Ctrl  |  J=Ctrl  K=Shift  L=Alt  ;=Gui
 *   Mac:  A=Ctrl S=Alt  D=Shift  F=Gui   |  J=Gui   K=Shift  L=Alt  ;=Ctrl
 */

#include "keys_ru.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE 0
#define MAC  1
#define NAV  2
#define SYM  3
#define ADJ  4

/ {
    behaviors {
        /* Home-row mods — positional: hold fires only when chorded with the
           opposite hand, so fast same-hand rolls stay clean. */
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-on-release;
            /* all right-hand keys */
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 43 44 45 46 47 48 49 55 56 57 58 59>;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-on-release;
            /* all left-hand keys */
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 42 50 51 52 53 54>;
        };

        /* Encoders — behaviour changes per active layer */
        enc_vol: enc_vol {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&kp C_VOL_UP>, <&kp C_VOL_DN>;
        };
        enc_scroll: enc_scroll {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&kp PG_UP>, <&kp PG_DN>;
        };
        enc_zoom: enc_zoom {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&kp LC(EQUAL)>, <&kp LC(MINUS)>;
        };
        enc_bright: enc_bright {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&kp F24>, <&kp F23>;  /* Qube screen brightness up/down */
        };
    };

    macros {
        /* C# / IDE convenience — Windows variants (used on the base layer) */
        qa: qa {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(DOT)>;        /* Quick Actions / lightbulb: Ctrl+. */
        };
        build_sol: build_sol {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LS(B))>;      /* Build Solution: Ctrl+Shift+B */
        };
        /* macOS variants — live on the MAC overlay at the same keys */
        qa_mac: qa_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(DOT)>;        /* Quick Actions: Cmd+. */
        };
        build_mac: build_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LS(B))>;      /* Build: Cmd+Shift+B */
        };
        lambda: lambda {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EQUAL &kp GT>;   /* => */
        };
    };

    combos {
        compatible = "zmk,combos";
        /* both shift keys -> Caps Word (types CONSTANT_LIKE_THIS, auto-cancels) */
        combo_caps {
            bindings = <&caps_word>;
            key-positions = <36 49>;
            timeout-ms = <50>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri {
            if-layers = <NAV SYM>;
            then-layer = <ADJ>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "Base";
            bindings = <
&kp ESC    &kp N1       &kp N2       &kp N3        &kp N4        &kp N5                          &kp N6   &kp N7        &kp N8        &kp N9       &kp N0          &kp LBKT
&kp TAB    &kp Q        &kp W        &kp E         &kp R         &kp T                           &kp Y    &kp U         &kp I         &kp O        &kp P           &kp RBKT
&kp GRAVE  &hml LGUI A  &hml LALT S  &hml LSHFT D  &hml LCTRL F  &kp G                           &kp H    &hmr RCTRL J  &hmr RSHFT K  &hmr LALT L  &hmr RGUI SEMI  &kp SQT
&kp LSHFT  &kp Z        &kp X        &kp C         &kp V         &kp B   &qa          &build_sol  &kp N    &kp M         &kp COMMA     &kp DOT      &kp FSLH        &kp RSHFT
                        &kp DEL      &kp TAB       &kp LGUI      &mo NAV  &kp SPACE    &kp RET     &mo SYM  &kp BSPC      &kp RALT      &kp RGUI
            >;
            sensor-bindings = <&enc_vol>, <&enc_vol>, <&enc_vol>, <&enc_vol>, <&enc_vol>, <&enc_vol>;
        };

        mac {
            display-name = "Mac";
            /* only swap Ctrl<->Gui on the home row + Mac IDE macros; rest passes through */
            bindings = <
&trans  &trans        &trans  &trans  &trans       &trans                       &trans  &trans       &trans  &trans  &trans          &trans
&trans  &trans        &trans  &trans  &trans       &trans                       &trans  &trans       &trans  &trans  &trans          &trans
&trans  &hml LCTRL A  &trans  &trans  &hml LGUI F  &trans                       &trans  &hmr RGUI J  &trans  &trans  &hmr RCTRL SEMI &trans
&trans  &trans        &trans  &trans  &trans       &trans  &qa_mac   &build_mac  &trans  &trans       &trans  &trans  &trans          &trans
                      &trans  &trans  &trans       &trans  &trans    &trans      &trans  &trans       &trans  &trans
            >;
        };

        nav {
            display-name = "Nav";
            bindings = <
&kp GRAVE  &kp F1    &kp F2    &kp F3     &kp F4     &kp F5                        &kp F6     &kp F7    &kp F8   &kp F9     &kp F10  &kp F11
&trans     &trans    &trans    &trans     &trans     &trans                        &kp PG_UP  &kp HOME  &kp UP   &kp END    &kp INS  &kp F12
&trans     &kp LGUI  &kp LALT  &kp LSHFT  &kp LCTRL  &trans                        &kp PG_DN  &kp LEFT  &kp DOWN &kp RIGHT  &kp DEL  &trans
&kp LSHFT  &trans    &trans    &trans     &trans     &trans  &trans     &trans      &kp HOME   &kp END   &trans   &trans     &trans   &kp RSHFT
                     &trans    &trans     &trans     &trans  &trans     &trans      &trans     &trans    &trans   &trans
            >;
            sensor-bindings = <&enc_scroll>, <&enc_scroll>, <&enc_scroll>, <&enc_scroll>, <&enc_scroll>, <&enc_scroll>;
        };

        sym {
            display-name = "Sym";
            bindings = <
&trans  &trans     &kp AT    &kp DLLR   &kp HASH  &trans                       &trans     &trans    &kp CARET  &trans    &trans    &trans
&trans  &trans     &kp LT    &kp EQUAL  &kp GT    &kp GRAVE                    &lambda    &kp LBKT  &kp UNDER  &kp RBKT  &trans    &trans
&trans  &kp BSLH   &kp LPAR  &kp MINUS  &kp RPAR  &kp PLUS                     &kp PRCNT  &kp LBRC  &kp SEMI   &kp RBRC  &kp EXCL  &kp QUESTION
&trans  &kp COMMA  &kp STAR  &kp COLON  &kp FSLH  &trans  &trans     &trans    &trans     &kp PIPE  &kp TILDE  &kp AMPS  &kp DOT   &trans
                   &trans    &trans     &trans    &trans  &trans     &trans    &trans     &trans    &trans     &trans
            >;
            sensor-bindings = <&enc_zoom>, <&enc_zoom>, <&enc_zoom>, <&enc_zoom>, <&enc_zoom>, <&enc_zoom>;
        };

        adj {
            display-name = "Adj";
            bindings = <
&bootloader  &kp F23   &kp F24  &trans  &trans  &trans                          &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2      &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR_ALL
&trans       &tog MAC  &trans   &trans  &trans  &trans                          &trans        &trans        &trans            &trans        &trans        &studio_unlock
&trans       &trans    &trans   &trans  &trans  &trans                          &out OUT_BLE  &kp C_VOL_DN  &kp C_MUTE        &kp C_VOL_UP  &trans        &trans
&trans       &trans    &trans   &trans  &trans  &trans  &trans       &trans     &out OUT_USB  &kp C_PREV    &kp C_PLAY_PAUSE  &kp C_NEXT    &trans        &trans
                       &trans   &trans  &trans  &trans  &trans       &trans     &trans        &trans        &trans            &trans
            >;
            sensor-bindings = <&enc_bright>, <&enc_bright>, <&enc_bright>, <&enc_bright>, <&enc_bright>, <&enc_bright>;
        };
    };
};
